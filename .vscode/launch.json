{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "bilig: extract",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/bilig-cli.py",
            "args": ["extract", "data/boursobank"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "pytest: all tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
